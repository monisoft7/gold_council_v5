# انسخ هذا الملف إلى .env وأدخل القيم محلياً. لا ترفع .env إلى GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq — تفسير نصي اختياري فقط
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Conduit أو أي مزود متوافق مع OpenAI — اختياري
CONDUIT_API_KEY=
CONDUIT_BASE_URL=
CONDUIT_MODEL=

# يمكن بدلاً من ذلك ضبط مزود OpenAI-compatible مباشرة
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# المصادر الرسمية
FRED_API_KEY=
BLS_API_KEY=

# التشغيل الورقي
PAPER_CAPITAL=10000
RISK_PCT=1.0
TG_NOTIFY_MODE=change
