# انسخ هذا الملف إلى .env وأدخل القيم محلياً. لا ترفع .env إلى GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq — تفسير نصي اختياري فقط
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Conduit أو أي مزود متوافق مع OpenAI — اختياري
CONDUIT_API_KEY=
CONDUIT_BASE_URL=
CONDUIT_MODEL=

# يمكن بدلاً من ذلك ضبط مزود OpenAI-compatible مباشرة
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# المصادر الرسمية
FRED_API_KEY=
BLS_API_KEY=

# التشغيل الورقي
PAPER_CAPITAL=10000
RISK_PCT=1.0
TG_NOTIFY_MODE=change

# MetaTrader 5 — حساب DEMO فقط. يمكن ترك بيانات الدخول فارغة إذا كانت
# الطرفية مفتوحة ومسجل الدخول فيها بالفعل.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD
MT5_DEVIATION=20
