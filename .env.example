# انسخ هذا الملف إلى .env وأدخل القيم محلياً. لا ترفع .env إلى GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq — تفسير نصي اختياري فقط
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Gemini عبر طبقة OpenAI الرسمية. دوّر المفتاح فوراً إذا ظهر في محادثة/سجل.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter: نماذج :free محدودة يومياً وقد تتغير إتاحتها.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# مزودو الأخبار
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=

# B.AI هو المزود الأساسي؛ النموذج الافتراضي موثق حالياً بـ 0 credits.
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
BAI_MODEL=qwen3.8-flash

# احتياطيات تجريبية. تحقق من التسعير قبل أي معالجة تاريخية كثيفة.
GOROUTER_API_KEY=
GOROUTER_BASE_URL=https://gorouter.app/v1
GOROUTER_MODEL=claude-opus-5
KKTOKEN_API_KEY=
KKTOKEN_BASE_URL=https://kktoken.cc/v1
KKTOKEN_MODEL=claude-opus-5

# يمكن بدلاً من ذلك ضبط مزود OpenAI-compatible مباشرة
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# المصادر الرسمية
FRED_API_KEY=
BLS_API_KEY=

# التشغيل الورقي
PAPER_CAPITAL=10000
RISK_PCT=1.0
TG_NOTIFY_MODE=change

# MetaTrader 5 — حساب DEMO فقط. يمكن ترك بيانات الدخول فارغة إذا كانت
# الطرفية مفتوحة ومسجل الدخول فيها بالفعل.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD
MT5_DEVIATION=20
